{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yukibana-swift",
  "compatibility_date": "2026-09-01",

  // Claim the hostname as part of the deploy. Without this the domain stays attached to
  // whatever Worker holds it — a freshly created one answers "Hello world" on every
  // path, which is indistinguishable from "my build did not deploy".
  "routes": [
    { "pattern": "swift.yukibana.dev", "custom_domain": true }
  ],

  // This config lives at the repository root, not in packages/ide, because Cloudflare
  // Workers Builds runs its deploy command from the root: a config anywhere else needs
  // an explicit -c, and the default `wrangler deploy` fails with "Missing entry-point".
  //
  // Only the app is uploaded as static assets: individual assets are capped at 25 MiB
  // and swift-frontend.wasm is 146 MiB. scripts/prepare-deploy.sh assembles ./deploy and
  // fails the build if anything in it exceeds the cap.
  //
  // The toolchain instead stays in its GitHub release, and the Worker proxies it under
  // /toolchain/* — same origin, so no CORS, with the content types wasm needs and edge
  // caching in front of GitHub.
  "main": "packages/ide/src/worker.js",
  "assets": {
    "directory": "packages/ide/deploy",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Points at the prebuilt artifacts branch while the release build finishes. The
  // Worker prefers a <name>.gz next to each artifact, so this serves 69 MiB per cold
  // visit rather than 302 MiB. Move it to
  // https://github.com/tothambrus11/swift-toolchain-wasm/releases/latest/download once a
  // release is published — the release carries .gz files too, so nothing else changes.
  "vars": {
    "TOOLCHAIN_RELEASE": "https://raw.githubusercontent.com/tothambrus11/swift-toolchain-wasm/toolchain-artifacts"
  }
}
