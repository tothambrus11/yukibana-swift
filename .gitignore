node_modules/
dist/
build/
.build/
*.tsbuildinfo
toolchain/out/
toolchain/src/

# Stage 0 artifacts staged by scripts/build-example.sh
packages/playground/public/hello.wasm
packages/playground/public/hello.swift
packages/playground/public/swift-parse.wasm
lib/
toolchain/build/
packages/ide/lib/
packages/ide/src-gen/
packages/ide/gen-webpack*.js
packages/ide/public/toolchain/
packages/*/lib/

# Toolchain artifacts staged for the web apps: hundreds of MiB, produced by
# swift-toolchain-wasm and fetched from its releases, never committed here.
packages/playground/public/toolchain/
packages/ide/lib/

# Assembled by scripts/prepare-deploy.sh from the build output; never committed.
packages/*/deploy/

# TypeScript output belongs in dist/ and lib/; never beside the sources.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# Theia generates these from the "theia.target" in package.json. gen-esbuild.*.mjs say
# so in their own header; esbuild.mjs is written once and then never rewritten, so a
# committed copy pins the build to whichever target was set when it was first created.
# Committing them made the browser-only build still try to bundle a backend that
# browser-only does not generate.
packages/ide/esbuild.mjs
packages/ide/gen-esbuild.*.mjs
