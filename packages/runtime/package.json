{
  "name": "@yukibana/runtime",
  "version": "0.1.0",
  "description": "Virtual filesystem, WASI runner and compiler-backend interface shared by the Yukibana IDE workers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && npm run bundle:worker",
    "test": "npm run build && node --test test/*.test.js",
    "bundle:worker": "esbuild src/compile-worker.ts --bundle --format=esm --platform=browser --outfile=dist/compile-worker.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
}
