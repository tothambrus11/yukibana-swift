{
  "name": "@yukibana/ide",
  "version": "0.1.0",
  "private": true,
  "description": "Theia browser application hosting the Yukibana Swift IDE",
  "license": "MIT",
  "dependencies": {
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/outline-view": "1.75.0",
    "@theia/output": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/workspace": "1.75.0",
    "@yukibana/theia-extension": "file:../theia-yukibana",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "scripts": {
    "clean": "theia clean",
    "build": "theia build --mode development && cp ../runtime/dist/compile-worker.js lib/frontend/compile-worker.js",
    "start": "theia start --hostname 0.0.0.0 --port 3000",
    "serve": "node ../../scripts/serve-static.js lib/frontend 3000",
    "build:prod": "theia build --mode production && cp ../runtime/dist/compile-worker.js lib/frontend/compile-worker.js",
    "prepare-deploy": "bash ../../scripts/prepare-deploy.sh ide",
    "deploy": "npm run build:prod && npm run prepare-deploy && wrangler deploy -c ../../wrangler.jsonc",
    "copy:worker": "cp ../runtime/dist/compile-worker.js lib/frontend/compile-worker.js"
  },
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "Yukibana",
        "preferences": {
          "files.enableTrash": false,
          "editor.fontSize": 13,
          "security.workspace.trust.enabled": false,
          "workbench.colorTheme": "dark"
        }
      }
    }
  }
}
