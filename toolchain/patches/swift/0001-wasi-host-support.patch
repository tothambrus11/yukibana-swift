diff --git a/SwiftCompilerSources/CMakeLists.txt b/SwiftCompilerSources/CMakeLists.txt
index f5596388..d0ec7701 100644
--- a/SwiftCompilerSources/CMakeLists.txt
+++ b/SwiftCompilerSources/CMakeLists.txt
@@ -295,7 +295,14 @@ function(add_swift_compiler_modules_library name)
       COMMENT "Building swift module ${module}")
 
     if(BOOTSTRAPPING_MODE STREQUAL "CROSSCOMPILE")
