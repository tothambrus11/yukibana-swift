   WSADATA WsaData;
@@ -356,3 +361,5 @@ ssize_t raw_socket_stream::read(char *Ptr, size_t Size,
   }
   return raw_fd_stream::read(Ptr, Size);
 }
+
+#endif // !defined(__wasi__)
